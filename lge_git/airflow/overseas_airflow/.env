# =============================================================================
# Overseas Airflow 환경설정 파일  (batches_dynamic.py / jobs_dynamic.py 전용)
# =============================================================================
#  이 파일은 버전관리에 포함하지 마세요 (.gitignore에 추가 권장)
#  Batch Meta UI 플러그인 설정은 plugins/.env 에서 별도 관리합니다
# =============================================================================

# -----------------------------------------------------------------------------
# [1] 메타 DB 접속 정보 (PostgreSQL)
# -----------------------------------------------------------------------------
META_PG_HOST=10.182.32.210
META_PG_PORT=8110
META_PG_DB=airflow_db
META_PG_USER=airflow
META_PG_PASSWORD=tttt
META_PG_SSLMODE=disable

# -----------------------------------------------------------------------------
# [2] Batch DAG 실행 제어
# -----------------------------------------------------------------------------

# ▶ 동시에 실행할 수 있는 최대 Batch DAG 수 (0 = 무제한)
#   - 공용 Pool(batch_concurrency_pool)로 전체 동시 task 수를 제어합니다.
#   - Pool 슬롯 수 = MAX_CONCURRENT_BATCHES × MAX_ACTIVE_TASKS_PER_BATCH
#   - 예) 4 × 2 = 전체 동시 task 최대 8개 (4배치 × 배치당 2태스크)
MAX_CONCURRENT_BATCHES=4

# Batch DAG 1개당 동시에 실행할 수 있는 최대 Task 수 (max_active_tasks)
# ※ MAX_CONCURRENT_BATCHES 와 곱해져 공용 Pool 총 슬롯 수가 됩니다.
MAX_ACTIVE_TASKS_PER_BATCH=2

# Batch DAG 1개당 동시에 실행할 수 있는 최대 DAG Run 수 (max_active_runs)
# 중복 실행 방지를 위해 1 권장
MAX_ACTIVE_RUNS_PER_BATCH=1

# -----------------------------------------------------------------------------
# [3] Job DAG 실행 제어
# -----------------------------------------------------------------------------

# Job DAG 1개당 동시에 실행할 수 있는 최대 DAG Run 수 (max_active_runs)
MAX_ACTIVE_RUNS_PER_JOB=1

# -----------------------------------------------------------------------------
# [4] 메일 발송 설정 (SMTP)  정기 배치 실패 알림용
# -----------------------------------------------------------------------------
SMTP_SERVER=lgekrhqmh01.lge.com
SMTP_PORT=25
SMTP_USER=overseas.spw
SMTP_PASSWORD=tttt
SMTP_FROM=overseas.spw@lge.com
# 기본 수신자 (job에 이메일 미설정 시 폴백, 비워두면 폴백 없음)
SMTP_DEFAULT_TO=

# -----------------------------------------------------------------------------
# [5] Airflow URL  실패 메일 내 링크 생성용
# -----------------------------------------------------------------------------
AIRFLOW_URL=http://10.182.33.70:8115

# -----------------------------------------------------------------------------
# [6] 쿼리 실행 타임아웃 (utils/db_util.py)
# -----------------------------------------------------------------------------
# ▶ BigQuery / PostgreSQL 쿼리 실행 최대 시간(초). 기본 600초(10분).
#   - BigQuery : job_timeout_ms 로 서버측 최대 실행 시간 제한
#   - PostgreSQL : statement_timeout 으로 세션 최대 실행 시간 제한
#   - 0 으로 두면 기본값(600초) 적용
QUERY_TIMEOUT_SEC=1200

# BQ Storage Read API 스트림 읽기 타임아웃(초)
# 조회결과를 스트림 단위로 읽을 때, 스트림 전체를 다 읽는 데 걸리는 최대 시간 제한
# - 0 으로 두면 기본값(300초) 적용
BQ_READ_TIMEOUT_SEC=1200
